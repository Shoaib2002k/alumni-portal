<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.alumni.model.User" %>
<%
    /* Session key confirmed from AlumniLoginServlet: session.setAttribute("user", user) */
    User loggedInUser = (User) session.getAttribute("user");
    boolean isLoggedIn = (loggedInUser != null);

    String logoPathHeader = "assets/img/logoonly.PNG";
    java.util.Map<String, String> headerSettings =
        (java.util.Map<String, String>) request.getAttribute("settings");
    if (headerSettings != null
            && headerSettings.get("LOGO_PATH") != null
            && !headerSettings.get("LOGO_PATH").trim().isEmpty()) {
        logoPathHeader = headerSettings.get("LOGO_PATH");
    }
%>

<!-- TOP BAR -->
<div class="topbar">
    <div class="container d-flex justify-content-between align-items-center flex-wrap">
        <div class="topbar-text">Follow us on social media</div>
        <div class="social-links">
            <a href="https://www.facebook.com/"  target="_blank" title="Facebook" ><i class="bi bi-facebook"></i></a>
            <a href="https://x.com/"             target="_blank" title="X"         ><i class="bi bi-twitter-x"></i></a>
            <a href="https://www.linkedin.com/"  target="_blank" title="LinkedIn"  ><i class="bi bi-linkedin"></i></a>
            <a href="https://www.youtube.com/"   target="_blank" title="YouTube"   ><i class="bi bi-youtube"></i></a>
            <a href="https://www.instagram.com/" target="_blank" title="Instagram" ><i class="bi bi-instagram"></i></a>
        </div>
    </div>
</div>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark main-navbar" id="mainNavbar">
    <div class="container-fluid px-4">

        <a class="navbar-brand brand-area" href="<%=request.getContextPath()%>/home">
            <img src="<%=request.getContextPath()%>/<%=logoPathHeader%>"
                 alt="MEASI Logo" class="site-logo">
            <div class="navbar-brand-text">
                <div class="line1">MEASI Institute of Information Technology</div>
                <div class="line2">Alumni Web Portal</div>
            </div>
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav ms-auto align-items-lg-center nav-menu">
                <li class="nav-item">
                    <a class="nav-link" href="<%=request.getContextPath()%>/home">HOME</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="<%=request.getContextPath()%>/home#about">ABOUT US</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="<%=request.getContextPath()%>/members">MEMBERS</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="<%=request.getContextPath()%>/gallery">GALLERY</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="<%=request.getContextPath()%>/events">EVENTS</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="<%=request.getContextPath()%>/home#contact">CONTACT</a>
                </li>

                <% if (isLoggedIn) { %>
                <!-- Logged-in: show user dropdown, hide Become an Alumni -->
                <li class="nav-item dropdown ms-lg-3">
                    <a class="nav-link dropdown-toggle alumni-logged-btn"
                       href="#" id="userDropdown" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-1"></i>
                        <%= loggedInUser.getFullName() %>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li>
                            <a class="dropdown-item"
                               href="<%=request.getContextPath()%>/portal/welcome.jsp">
                                <i class="bi bi-house me-2"></i>My Dashboard
                            </a>
                        </li>
                        <li>
    <a class="dropdown-item"
       href="<%=request.getContextPath()%>/portal/virtual-id">
        <i class="bi bi-card-heading me-2"></i>Virtual ID
    </a>
</li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger"
                               href="<%=request.getContextPath()%>/logout">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </a>
                        </li>
                    </ul>
                </li>
                <% } else { %>
                <!-- Guest: show Become an Alumni button -->
                <li class="nav-item ms-lg-3">
                    <a href="<%=request.getContextPath()%>/auth/login.jsp"
                       class="btn btn-light alumni-btn">
                        BECOME AN ALUMNI
                    </a>
                </li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>

<!-- NAVBAR SHRINK ON SCROLL -->
<script>
window.addEventListener("scroll", function () {
    var navbar = document.getElementById("mainNavbar");
    if (navbar) {
        if (window.scrollY > 60) navbar.classList.add("shrink");
        else                      navbar.classList.remove("shrink");
    }
});
</script>

<style>
.alumni-logged-btn {
    background   : rgba(255,255,255,0.15) !important;
    border       : 1.5px solid rgba(255,255,255,0.55) !important;
    border-radius: 10px !important;
    padding      : 8px 16px !important;
    font-weight  : 700 !important;
    color        : #fff !important;
    transition   : background 0.2s;
}
.alumni-logged-btn:hover {
    background: rgba(255,255,255,0.28) !important;
}
.dropdown-menu {
    border-radius: 12px;
    box-shadow   : 0 8px 30px rgba(0,0,0,0.15);
    border       : none;
    min-width    : 200px;
    margin-top   : 6px;
}
.dropdown-item {
    padding    : 10px 18px;
    font-weight: 500;
}
.dropdown-item:hover { background: #f5f0eb; }
</style>
